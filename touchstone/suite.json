{
  "schema_version": 1,
  "name": "Checkout agent",
  "adapter": "adapter.py",
  "environment_paths": [
    "../checkout_env",
    "../grader"
  ],
  "requirements": [
    {
      "id": "right-items",
      "text": "Reward requires exactly the items and quantities the customer asked for."
    },
    {
      "id": "ship-to-user",
      "text": "Ship to the address the customer asked for; an order sent anywhere else, including the account's default address, earns no reward."
    },
    {
      "id": "valid-order",
      "text": "A correct order shipped to the requested address earns full reward."
    }
  ],
  "reward": {
    "direction": "higher_better",
    "path": "reward",
    "reference": null
  },
  "cases": [
    {
      "id": "correct-order",
      "title": "The right keyboard shipped to Daniel earns full reward",
      "requirement_id": "valid-order",
      "input": {
        "task": {
          "task_id": "t-0028",
          "customer_id": "cus_3307",
          "request": "Send a keyboard to my brother Daniel Okafor, 88 Ridge Rd, Houston TX 77002.",
          "items": [
            {
              "sku": "KB-MECH-87",
              "quantity": 1
            }
          ],
          "ship_to": {
            "name": "Daniel Okafor",
            "line1": "88 Ridge Rd",
            "line2": "",
            "city": "Houston",
            "region": "TX",
            "postal_code": "77002",
            "country": "US"
          }
        },
        "actions": [
          {
            "tool": "add_to_cart",
            "input": {
              "sku": "KB-MECH-87",
              "quantity": 1
            }
          },
          {
            "tool": "set_shipping_address",
            "input": {
              "address": {
                "name": "Daniel Okafor",
                "line1": "88 Ridge Rd",
                "line2": "",
                "city": "Houston",
                "region": "TX",
                "postal_code": "77002",
                "country": "US"
              }
            }
          },
          {
            "tool": "place_order",
            "input": {}
          }
        ]
      },
      "assertions": [
        {
          "path": "reward",
          "operator": "eq",
          "expected": 1
        }
      ],
      "provenance": {
        "kind": "template",
        "source": "Checkout demo"
      },
      "control": "reference",
      "required_case_ids": []
    },
